
recursive apprach 
// Time: O(N)
// Space: O(N)

class Solution {
public:
    string countAndSay(int n) {
        if(n == 1) return "1";

        string s = countAndSay(n - 1);
        string ans;

        int m = s.size();

        for(int i = 0; i < m; i++) {

            char d = s[i];
            int cnt = 1;

            while(i + 1 < m && s[i] == s[i + 1]) {
                cnt++;
                i++;
            }

            ans += to_string(cnt);
            ans += d;
        }

        return ans;
    }
};



Iterative apprach 
// Time: O(N)
// Space: O(N)

class Solution {
public:
    string countAndSay(int n) {
       string ans="1"; 
       while(--n){
        string next; int i =0;
        while(i<ans.size()){
            char d= ans[i]; 
            int cnt=0;
            while(i<ans.size() && ans[i]==d){
                cnt++;
                i++;
            }
            next+=to_string(cnt)+d;
        }
        ans= next;
       } 
       return ans;
    }
};